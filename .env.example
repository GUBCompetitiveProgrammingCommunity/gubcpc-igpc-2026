# Base URL of the gubcpc-server-2 backend that this site registers against.
# Use http://localhost:5000 for local development, the production API URL when deployed.
VITE_API_BASE_URL=https://api.gubcpc.com

# Slug of the contest (in the backend's Contests table) that this site's
# registration form should read config from and submit registrations to.
VITE_CONTEST_SLUG=your-contest-slug

# Per-contest API key required to POST a registration (x-api-key header).
# Get this from the admin panel: Admin > Contests > (this contest) > API Key.
# Leave blank in this example file - never commit a real key.
VITE_CONTEST_API_KEY=

